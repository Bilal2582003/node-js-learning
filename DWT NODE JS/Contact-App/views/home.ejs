<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="table.css" >
    <div class="container p-3">
      <div class="row">
        <div class="col-6">
          <h1>Contact Table</h1>
        </div>
        <div class="col-6">
          <a href="/add-contact" class="btn btn-md btn-outline-info">Add +</a>
        </div>
      </div>
      <hr>
      <div class="row">

        <table class="rwd-table col-12">
          <tr>
              <th>ID</th>
              <th>F-Name</th>
              <th>L-Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Address</th>
              <th>Actions</th>
            </tr>
          <tbody>
            <%
            var srno = 1;
             contacts.forEach( contact =>{ %>
              <tr>
                <td data-th="Supplier Code"><%=  srno++ %></td>
                <td data-th="Supplier Name"><%= contact.first_name %></td>
                <td data-th="Invoice Number"><%= contact.last_name %></td>
                <td data-th="Invoice Date"><%= contact.email %></td>
                <td data-th="Invoice Date"><%= contact.phone %></td>
                <td data-th="Invoice Date"><%= contact.address %></td>
                <td>
                  <a style="text-decoration: none;" href="/show-contact/<%= contact._id %>"><span class="btn btn-sm rounded-circle btn-circle btn-outline-info">👁</span></a>
                  <a style="text-decoration: none;" href="/update-contact/<%= contact._id %>"><span class="btn btn-sm rounded-circle btn-circle btn-outline-secondary">🖊️</span></a>
                    <a style="text-decoration: none;" href="/delete-contact/<%= contact._id %>"><span class="btn btn-sm rounded-circle btn-circle btn-outline-danger" onclick="confirm('Are you sure?')">❌</span></a>
                  </td>
                </tr>

            <% } ) %>
             
                
              </tbody>
            </table>
          </div>
            <!-- <h3>Resize Me</h3> -->
        </div>
        <%- include('partials/footer.ejs') %>